// ─────────────────────────────────────────────────────────────────────────────
// HERO BANNER — Feature #15 (homepage hero carousel CMS).
// ─────────────────────────────────────────────────────────────────────────────
//
// Admin-managed slides for the homepage hero carousel. Each row is a single
// slide. The frontend carousel sorts active+in-window rows by displayOrder
// (ASC) and renders them.
//
// Why a dedicated table and not a re-use of Promotion?
//   - Promotion holds banner *content* but not headline / subheadline / CTA
//     copy / per-breakpoint imagery. The marketing surface needs all four.
//   - Promotion is also used by /admin/promotions for sidebar / strip
//     placements; conflating the two would put churn on a model that
//     governs other UX.
//
// Lifecycle:
//   - isActive=false hides the slide regardless of dates.
//   - startsAt/endsAt are OPTIONAL — null = no bound on that side. This is
//     how an admin pins an "evergreen" hero (no schedule). When both are
//     set, the slide is visible only when `now ∈ [startsAt, endsAt]`.
//   - displayOrder governs render order; ties broken by createdAt DESC.
//
// Image strategy (per spec): separate desktop + mobile images. The
// frontend uses `<picture>` to pick the right one without JS so the right
// asset downloads on the right device.
model HeroBanner {
  id              String    @id @default(cuid())
  // Internal admin label — never shown to shoppers.
  name            String
  // Marketing copy. Headline is required; subheadline is optional.
  headline        String
  subheadline     String?
  // CTA button. Both fields nullable — a banner may be purely informational.
  ctaLabel        String?
  ctaHref         String?
  // Background images. `imageDesktopUrl` is required; mobile falls back to desktop.
  imageDesktopUrl String
  imageMobileUrl  String?
  // Accessibility — alt text used on both <img>s; if blank, slide is
  // decorative (alt="") and the headline carries the announcement.
  imageAlt        String?
  // Optional text colour override ("light" | "dark"). Null = auto/light.
  textColor       String?
  // Optional translucent overlay tint to improve text contrast (0-100).
  overlayOpacity  Int       @default(35)

  // ── Lifecycle ───────────────────────────────────────────────────────────
  isActive        Boolean   @default(true)
  displayOrder    Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?

  // ── Audit ──────────────────────────────────────────────────────────────
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  updatedById     String?

  @@index([isActive, displayOrder])
  @@index([startsAt, endsAt])
}

model EmailCampaign {
  id             String   @id @default(cuid())
  subject        String
  bodyHtml       String
  audience       String   // ALL | B2C | B2B | SEGMENT_JSON
  scheduledAt    DateTime?
