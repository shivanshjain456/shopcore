// ─────────────────────────────────────────────────────────────────────────────
// IDEMPOTENCY — guarantees one purchase intent → at most one order
// ─────────────────────────────────────────────────────────────────────────────
//
// Generic across endpoints (currently used by /api/checkout/place-order).
// Status lifecycle:
//   PROCESSING — INSERTed at the start of the operation; other concurrent
//                callers with the same (userId, key) see this row and poll.
//   SUCCEEDED  — operation completed; `result` holds the JSON we returned.
//   FAILED     — operation completed with an error; `result` holds the error
//                envelope. Retries with the same key get the SAME error rather
//                than re-running (so the user sees a stable outcome).
//
// The unique constraint on (userId, key) is what gives us "exactly once":
// if two concurrent requests race the INSERT, exactly one wins; the loser
// observes the row and waits.
//
// `requestFingerprint` is a SHA-256 of the normalised request payload. If a
// client REUSES a key with a different payload we return 409 — that's a
// programming error / replay attack, not an idempotent retry.

model IdempotencyKey {
  id                 String   @id @default(cuid())
  userId             String
  key                String
  endpoint           String   // e.g. 'POST /api/checkout/place-order'
  status             String   // PROCESSING | SUCCEEDED | FAILED
  requestFingerprint String   // sha256 hex of normalised request
  resultStatus       Int?     // HTTP status of the original response
  resultBody         String?  // JSON body of the original response
  resultOrderId      String?  // convenience pointer for checkout flows
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  expiresAt          DateTime // pruned by daily cron

  @@unique([userId, key])
  @@index([expiresAt])
  @@index([resultOrderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// UTR SUBMISSIONS — anti-fraud audit log + global uniqueness constraint
// ─────────────────────────────────────────────────────────────────────────────
//
// Every UTR a customer submits is recorded here, even rejected attempts.
// The unique constraint on `utrNormalized` provides ABSOLUTE protection
// against UTR-reuse fraud: even a race between two simultaneous orders is
// resolved by the DB; the second INSERT fails and the order is rejected.
//
// Rejected attempts (status='REJECTED_FORMAT' | 'REJECTED_FRAUD' |
// 'REJECTED_DUPLICATE') are kept for forensics and rate-limit signal.
// Accepted attempts (status='PENDING_REVIEW' | 'VERIFIED' | 'REJECTED_BY_ADMIN')
// trace the admin's hands-on decision.
//
// `utrNormalized` is the sanitised value (uppercased, alphanumeric-only) —
// this is what the unique constraint operates on. The raw `utrSubmitted`
// is kept for forensics ("what did the customer actually type?").

model UtrSubmission {
  id             String   @id @default(cuid())
  utrNormalized  String   // uppercased, alphanumeric-only — UNIQUE
  utrSubmitted   String   // raw exactly as customer typed
  paymentMethod  String   // UPI | IMPS | NEFT | RTGS
  orderId        String?  // null while the order itself is being created
  userId         String
  amountPaise    Int      // the order's grand total at submission time
  status         String   // ACCEPTED | REJECTED_FORMAT | REJECTED_FRAUD | REJECTED_DUPLICATE | VERIFIED | REJECTED_BY_ADMIN
  rejectReason   String?
  clientIp       String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  verifiedAt     DateTime?
  verifiedBy     String?  // admin id

  @@unique([utrNormalized])
  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPRESS CHECKOUT  (Feature — "Buy Now" direct-to-checkout)
// ─────────────────────────────────────────────────────────────────────────────
//
// One row per active Buy-Now session, keyed by userId so rapid clicks
// upsert the SAME row (no duplicates, no race storms). The cookie
// `sc_express` (HttpOnly, Path=/) carries this row's id; the checkout page
// looks it up by (cookie value, userId-from-session) and uses its contents
// INSTEAD of the user's Cart table — leaving the cart completely untouched.
//
// Lifecycle:
//   created  → user clicks Buy Now on PDP
//   updated  → user clicks Buy Now again (upsert by userId; same row)
//   consumed → placeOrder() sets consumedAt; row stays for audit + as a
//              dedupe key against accidental re-submits
//   expired  → expiresAt < now (default: 1h after creation/update)
//   pruned   → nightly cron in scripts/backup.ts after the audit window
//
// The express row is the SINGLE SOURCE OF TRUTH for the express checkout
// payload. We never trust the cookie's id alone — the row's userId MUST
// match the requesting session.

model ExpressCheckout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  quantity    Int
  // Set when placeOrder() succeeds; we keep the row briefly for audit and
  // to short-circuit accidental re-submits.
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId])          // one active express slot per user — upsert key
  @@index([expiresAt])
  @@index([consumedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — every admin action
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND JOBS — SQLite-backed queue + scheduler
// ─────────────────────────────────────────────────────────────────────────────
//
// Item 7 — Background Jobs System. See BUILD_LOG.md.
//
// Design intent:
//   - Single-process, single-Node-instance deployment (one VPS, one DB file).
//   - No Redis, no BullMQ, no external services — the queue rides on the
//     same SQLite database every other model lives in. One backup covers it.
//   - Atomic claim via `updateMany WHERE status='PENDING'` — the WHERE clause
//     is the race guard. Two concurrent runners (we have only one, but the
//     property is essential to correctness) can't both promote the same row.
//   - Stuck-PROCESSING recovery: a job whose `lockExpiresAt` has passed is
//     considered crashed and reclaimed back to PENDING by the next poll.
//   - Replaceable: should we outgrow SQLite, the queue can be migrated to
//     Redis/BullMQ by swapping `src/lib/jobs/producer.ts` + `runner.ts` —
//     the rest of the codebase only knows `enqueueJob(type, payload)`.

model Job {
  id              String    @id @default(cuid())
  type            String    // see src/lib/jobs/jobTypes.ts — JOB_TYPES registry
  status          String    @default("PENDING")   // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  payload         String    @default("{}")        // JSON-stringified, validated by the worker's Zod schema
  result          String?                         // JSON on success
  error           String?                         // JSON on failure: { name, code, message }
  priority        Int       @default(0)           // higher wins the tiebreaker
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  runAt           DateTime  @default(now())       // earliest pickup time
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  queueName       String    @default("default")   // logical queue separation (future)
  parentJobId     String?                         // for future job chains
  // Lock token + TTL implement the race-free claim. lockToken is rotated
  // (random uuid) every time a runner claims the row; the runner uses it
  // as a fencing token if it ever needs to confirm it still owns the job
  // (extendLock heartbeat). lockExpiresAt drives the stuck-job reclaim.
  lockToken       String?
  lockExpiresAt   DateTime?

  @@index([status, runAt, priority])
  @@index([type, status])
  @@index([queueName, status, runAt])
  @@index([parentJobId])
}

model JobSchedule {
  id              String    @id @default(cuid())
  name            String    @unique               // stable id: 'cleanup.expired_otps', etc.
  jobType         String    // value from JOB_TYPES
  payload         String    @default("{}")        // JSON template enqueued each tick
  cronExpression  String    // 5-field cron: `m h dom mon dow` — interpreted in UTC
  queueName       String    @default("default")
  isActive        Boolean   @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime  // computed from cronExpression at insert + after every fire
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, nextRunAt])
}
