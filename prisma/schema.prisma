  code             String   @unique
  description      String?
  discountType     String
  value            Int      // percent (0-100) OR paise
  minOrderPaise    Int      @default(0)
  maxDiscountPaise Int?
  usageLimit       Int?
  perUserLimit     Int?
  validFrom        DateTime
  validUntil       DateTime
  appliesToB2B     Boolean  @default(false)
  appliesToB2C     Boolean  @default(true)
