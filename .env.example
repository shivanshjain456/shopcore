# ─────────────────────────────────────────────────────────────────
# ShopCore — environment variables
# Copy this file to `.env` and fill real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
APP_NAME=ShopCore
APP_URL=http://localhost:3000

# --- Database (SQLite file path) ---
DATABASE_URL="file:../data/store.db"

# --- Session / Cookie crypto (generate with: openssl rand -hex 32) ---
SESSION_SECRET=replace_with_64_hex_chars_minimum
CSRF_SECRET=replace_with_64_hex_chars_minimum

# --- Firebase Admin SDK (download JSON from Firebase Console → Project Settings → Service Accounts) ---
# Paste the entire JSON on ONE LINE (escape internal quotes), OR set the path:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional alternative:
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-admin.json
FIREBASE_PROJECT_ID=

# --- Firebase Phone Authentication (Client SDK) ---
# Required in PRODUCTION for SMS-OTP phone verification (`preflight.ts`
# will refuse to start if any of these three is missing when NODE_ENV
# is `production`). In development they are optional — the verify-phone
# UI renders a "dev bypass" form that accepts the literal OTP `000000`
# when these vars are absent (the API rejects the bypass token outside
# of non-production NODE_ENV unconditionally).
#
# Get the values from:
#   Firebase Console → Project Settings → General → "Your apps" → Web app
#
# Embed at BUILD time (Next.js inlines NEXT_PUBLIC_* at compile time).
# Enable Phone in: Firebase Console → Authentication → Sign-in method.
# Add the production domain in: Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Email (Gmail SMTP, free, ≤500/day) ---
# Use a Gmail App Password, NOT your regular Gmail password.
# https://myaccount.google.com/apppasswords (2-Step Verification must be ON)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="ShopCore <your_gmail_address@gmail.com>"

# --- OTP policy ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Admin bootstrap (used by `npm run db:seed` to create the first admin) ---
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.in
BOOTSTRAP_ADMIN_PASSWORD=change_me_immediately
BOOTSTRAP_ADMIN_FIRSTNAME=Store
BOOTSTRAP_ADMIN_LASTNAME=Admin
BOOTSTRAP_ADMIN_PHONE=+910000000000

# --- Payment QR (your own UPI QR image lives in /public/payment/qr.png) ---
PAYMENT_UPI_ID=yourname@upi
PAYMENT_DISPLAY_NAME="Your Business Name"

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# --- Rate limiting ---
# Rate-limit numbers are NOT environment variables.
# All policies live in src/lib/security/rateLimitPolicies.ts (typed,
# code-reviewed, deployed). To change a limit, edit the policy and ship
# a deploy — this is intentional (limits are a security boundary).

# --- Background Jobs (Item 7 — SQLite-backed job runner + scheduler) ---
# Leave these unset to use the (sensible) defaults. The runner starts
# automatically inside the Next.js process (no separate worker daemon).
JOB_RUNNER_ENABLED=true                  # set to `false` on read-only replicas
JOB_RUNNER_POLL_INTERVAL_MS=5000         # poll cadence — wait between batches
JOB_RUNNER_BATCH_SIZE=5                  # max jobs claimed per poll
JOB_RUNNER_MAX_CONCURRENT=10             # in-flight job cap across the runner
JOB_RUNNER_LOCK_TTL_MS=300000            # 5 min — stuck-job reclaim threshold
JOB_RUNNER_DRAIN_TIMEOUT_MS=30000        # SIGTERM drain window
